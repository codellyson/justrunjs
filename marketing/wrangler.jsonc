{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justrunjs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The Astro build is served as static assets; only the API and sign-in pages reach the Worker.
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  // database_id: replace with the id printed by `wrangler d1 create justrunjs` before the first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "justrunjs", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [{ "name": "SIGNIN_RATE_LIMIT", "namespace_id": "531250", "simple": { "limit": 10, "period": 60 } }],
  "vars": { "MAIL_FROM": "signin@justrunjs.kreativekorna.com" },
  "observability": { "enabled": true },
  "dev": { "port": 8797 }
}
