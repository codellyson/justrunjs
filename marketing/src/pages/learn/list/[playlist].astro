---
// One playlist: the teacher, what the playlist covers, and every lesson in it with where the
// student is. Progress lives in the browser, so the page fills it in on load.
import "@fontsource-variable/recursive/full.css";
import "../../../learn/learn.css";
import Account from "../../../learn/Account.astro";
import { playlists, teacher } from "../../../learn/catalog";

export function getStaticPaths() {
  return playlists.map((p) => ({ params: { playlist: p.slug }, props: { playlist: p } }));
}

const { playlist } = Astro.props;
const lessons = playlist.lessons;
const pencil = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1a1512" />
    <title>{playlist.title} · crow</title>
    <meta name="description" content={playlist.intro} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  </head>
  <body class="learn">
    <header class="cp-top">
      <a class="cp-brand" href="/">crow</a>
      <a class="cp-toplink" href="/learn/">All playlists</a>
    </header>

    <main class="cp">
      <section class="cp-hero" aria-labelledby="cp-title">
        {teacher.photo && <div class="cp-photo"><img src={teacher.photo} alt="" /></div>}
        <div class="cp-hero-text">
          <p class="cp-by">A playlist by {teacher.name} · {lessons.length} {lessons.length === 1 ? "lesson" : "lessons"}</p>
          <h1 id="cp-title">{playlist.title}</h1>
          <p class="cp-intro">{playlist.intro}</p>
          <div class="cp-go">
            <a class="cp-cta" id="cp-cta" href={`/learn/${lessons[0].slug}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5v14l12-7z"></path></svg>
              <span id="cp-cta-label">Start the playlist</span>
            </a>
            <span class="cp-done-count" id="cp-done-count"></span>
          </div>
        </div>
      </section>

      <section class="cp-lessons" aria-labelledby="cp-lessons-h">
        <h2 id="cp-lessons-h">Lessons</h2>
        <ol class="cp-list">
          {lessons.map((l, i) => (
            <li class="cp-row" data-slug={l.slug} data-duration={l.durationMs} data-title={l.title}>
              <span class="cp-mark" aria-hidden="true">
                <span class="cp-num">{i + 1}</span>
                <svg class="cp-tick" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
              </span>
              <div class="cp-row-text">
                <span class="cp-state"></span>
                <a class="cp-row-title" href={`/learn/${l.slug}`}>{l.title}</a>
                <span class="cp-row-meta">{l.kind} · {l.length}<span class="cp-row-where"></span></span>
              </div>
              <a class="cp-copy" href={`/learn/${l.slug}`} hidden>
                <Fragment set:html={pencil} />
                <span class="cp-copy-label">Your copy</span>
              </a>
              <a class="cp-start" href={`/learn/${l.slug}`} aria-label={`Start ${l.title}`} hidden>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5v14l12-7z"></path></svg>
                <span class="cp-start-label">Start</span>
              </a>
            </li>
          ))}
        </ol>
        <Account />
      </section>

      <section class="cp-how" aria-labelledby="cp-how-h">
        <h2 id="cp-how-h">How the lessons work</h2>
        <p><strong class="cp-how-watch">Watch.</strong> I talk you through the code as I write it, right in the editor.</p>
        <p><strong class="cp-how-try">Try it.</strong> Click into the code at any moment. You get your own copy to change and run.</p>
        <p><strong>Come back.</strong> Continue the lesson from where I paused. Your copy stays saved.</p>
      </section>
    </main>
    <script>
      import { paintCourse, initAccount } from "../../../learn/course-page.ts";
      paintCourse();
      initAccount(paintCourse);
    </script>
  </body>
</html>
