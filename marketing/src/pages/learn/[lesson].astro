---
// One lesson: the instructor's narration replaying into a live editor. The look is the
// classroom's own and stays the same whatever theme the scratchpad uses.
import "@fontsource-variable/recursive/full.css";
import "../../learn/learn.css";
import course from "../../learn/course.json";
import { readFileSync } from "node:fs";

export function getStaticPaths() {
  // Relative to the project root (Astro's cwd): import.meta.url points into dist/ once bundled.
  return course.lessons.map((slug, i) => {
    const l = JSON.parse(readFileSync(`public/lessons/${slug}.json`, "utf8"));
    return { params: { lesson: slug }, props: { index: i, title: l.title as string } };
  });
}

const { index, title } = Astro.props;
const { lesson: slug } = Astro.params;
const total = course.lessons.length;
const teacher = course.teacher as { name: string; photo: string | null };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1a1512" />
    <title>{title} · {course.title}</title>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  </head>
  <body class="learn">
    <div class="lp" id="lp" data-slug={slug}>
      <header class="lp-top">
        <nav class="lp-where" aria-label="Where you are">
          <a class="lp-back" href="/learn/" aria-label={`Back to ${course.title}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
            <span class="lp-course">{course.title}</span>
          </a>
          <span class="lp-sep" aria-hidden="true">/</span>
          <span class="lp-title">{title}</span>
        </nav>
        <div class="lp-progress">
          <span class="lp-count-long">Lesson {index + 1} of {total}</span>
          <span class="lp-count-short" aria-hidden="true">{index + 1}/{total}</span>
          <span class="lp-dots" aria-hidden="true">
            {course.lessons.map((_, i) => <span class:list={["lp-dot", { here: i === index }]}></span>)}
          </span>
        </div>
      </header>

      <main class="lp-stage">
        <section class="lp-card" aria-label="The lesson's code">
          <div class="lp-files" id="lp-files" hidden>
            <span data-file="html">HTML</span>
            <span data-file="css">CSS</span>
            <span data-file="js">JS</span>
          </div>
          <div class="lp-editor" id="lp-editor"></div>
          <div class="lp-preview" id="lp-preview" hidden>
            <div class="lp-preview-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <iframe id="lp-frame" title="The lesson's page" sandbox="allow-scripts allow-modals allow-forms"></iframe>
          </div>
        </section>

        <div class="lp-voice">
          <div class="lp-teacher">
            <div class="lp-photo">
              {teacher.photo ? <img src={teacher.photo} alt="" /> : <span aria-hidden="true">{teacher.name.slice(0, 1)}</span>}
            </div>
            <span class="lp-name">{teacher.name}</span>
            <span class="lp-bars" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          </div>
          <p class="lp-caption" id="lp-caption" aria-live="polite"></p>
        </div>
      </main>

      <footer class="lp-player">
        <button type="button" class="lp-play" id="lp-play" aria-label="Play" disabled>
          <svg class="i-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5v14l12-7z"></path></svg>
          <svg class="i-pause" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
        </button>
        <span class="lp-time" id="lp-time">0:00</span>
        <div class="lp-track">
          <div class="lp-segments" id="lp-segments" aria-hidden="true"></div>
          <input type="range" id="lp-seek" min="0" step="100" value="0" aria-label="Lesson position" />
        </div>
        <div class="lp-extras">
          <select id="lp-speed" class="lp-chip" aria-label="Speed">
            <option value="0.75">0.75×</option>
            <option value="1" selected>1×</option>
            <option value="1.25">1.25×</option>
            <option value="1.5">1.5×</option>
            <option value="2">2×</option>
          </select>
          <button type="button" id="lp-cc" class="lp-chip" aria-pressed="true">
            <span class="lp-cc-long">Captions</span><span class="lp-cc-short" aria-hidden="true">CC</span>
          </button>
        </div>
      </footer>
    </div>
    <script>
      import { startLesson } from "../../learn/lesson-page.ts";
      startLesson(document.getElementById("lp")!.dataset.slug!);
    </script>
  </body>
</html>
