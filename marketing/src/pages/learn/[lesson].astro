---
// One lesson: the instructor's narration replaying into a live editor. The look is the
// classroom's own and stays the same whatever theme the scratchpad uses.
import "@fontsource-variable/recursive/full.css";
import "../../learn/learn.css";
import course from "../../learn/course.json";
import { readFileSync } from "node:fs";
import { formatTime } from "../../web/lesson";

export function getStaticPaths() {
  // Relative to the project root (Astro's cwd): import.meta.url points into dist/ once bundled.
  const lessons = course.lessons.map((slug) => {
    const l = JSON.parse(readFileSync(`public/lessons/${slug}.json`, "utf8"));
    return {
      slug,
      title: l.title as string,
      kind: l.kind === "playground" ? "Web page" : "Code",
      length: formatTime(l.durationMs),
    };
  });
  return lessons.map((l, i) => ({ params: { lesson: l.slug }, props: { index: i, title: l.title, next: lessons[i + 1] ?? null } }));
}

const { index, title, next } = Astro.props;
const { lesson: slug } = Astro.params;
const total = course.lessons.length;
const teacher = course.teacher as { name: string; photo: string | null };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1a1512" />
    <title>{title} · {course.title}</title>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  </head>
  <body class="learn">
    <div class="lp" id="lp" data-slug={slug} data-lessons={JSON.stringify(course.lessons)}>
      <header class="lp-top">
        <nav class="lp-where" aria-label="Where you are">
          <a class="lp-back" href="/learn/" aria-label={`Back to ${course.title}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
            <span class="lp-course">{course.title}</span>
          </a>
          <span class="lp-sep" aria-hidden="true">/</span>
          <span class="lp-title">{title}</span>
        </nav>
        <div class="lp-progress">
          <span class="lp-count-long" id="lp-count">Lesson {index + 1} of {total}</span>
          <span class="lp-count-short" aria-hidden="true">{index + 1}/{total}</span>
          <span class="lp-dots" aria-hidden="true">
            {course.lessons.map((s, i) => <span class:list={["lp-dot", { here: i === index }]} data-slug={s}></span>)}
          </span>
        </div>
      </header>

      <main class="lp-stage">
        <section class="lp-card" aria-label="The lesson's code">
          <div class="lp-cardhead">
            <span class="lp-end-chip"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg> Where we ended up</span>
            <span class="lp-mine-chip"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg> Your copy</span>
            <div class="lp-files" id="lp-files" hidden>
              <button type="button" data-file="html">HTML</button>
              <button type="button" data-file="css">CSS</button>
              <button type="button" data-file="js">JS</button>
            </div>
            <button type="button" class="lp-try" id="lp-try" disabled><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg> <span class="lp-try-long">Click into the code any time to try it yourself</span><span class="lp-try-short">Try it yourself</span></button>
            <span class="lp-saved" id="lp-saved" role="status"></span>
          </div>
          <div class="lp-editor" id="lp-editor"></div>
          <div class="lp-preview" id="lp-preview" hidden>
            <div class="lp-preview-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <iframe id="lp-frame" title="The lesson's page" sandbox="allow-scripts allow-modals allow-forms"></iframe>
          </div>
        </section>

        <div class="lp-voice">
          <div class="lp-teacher">
            {/* No photo yet: no stand-in face, just the name and the speaking bars. */}
            {teacher.photo && (
              <div class="lp-photo-wrap">
                <div class="lp-photo"><img src={teacher.photo} alt="" /></div>
                <span class="lp-badge" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg></span>
              </div>
            )}
            <span class="lp-name">{teacher.name}</span>
            <span class="lp-bars" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          </div>
          <p class="lp-caption" id="lp-caption" aria-live="polite"></p>
          <div class="lp-end">
            <div class="lp-yt-words">
              <p class="lp-yt-title">That's it. Now it's yours.</p>
              <p class="lp-yt-text" id="lp-end-text"></p>
              <div class="lp-yt-actions">
                <button type="button" class="lp-btn lp-btn-student" id="lp-end-try">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>
                  Try it yourself
                </button>
                <button type="button" class="lp-btn" id="lp-again">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path></svg>
                  Watch again
                </button>
              </div>
            </div>
            {next ? (
              <a class="lp-next" href={`/learn/${next.slug}`}>
                <span class="lp-next-label">Up next · Lesson {index + 2}</span>
                <span class="lp-next-title">{next.title}</span>
                <span class="lp-next-foot"><span>{next.kind} · {next.length}</span><span class="lp-next-go" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></span></span>
              </a>
            ) : (
              <a class="lp-next" href="/learn/">
                <span class="lp-next-label">That was the last lesson</span>
                <span class="lp-next-title">Back to {course.title}</span>
                <span class="lp-next-foot"><span>Every lesson and your copies</span><span class="lp-next-go" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></span></span>
              </a>
            )}
          </div>
          <div class="lp-yourturn" id="lp-yourturn">
            <div class="lp-yt-words">
              <p class="lp-yt-title">Your turn.</p>
              <p class="lp-yt-text" id="lp-yt-text"></p>
            </div>
            <div class="lp-yt-actions">
              <button type="button" class="lp-btn lp-btn-main" id="lp-continue">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5v14l12-7z"></path></svg>
                <span id="lp-continue-label">Continue the lesson</span>
              </button>
              <button type="button" class="lp-btn" id="lp-reset">Reset to my code</button>
            </div>
          </div>
        </div>
      </main>

      <footer class="lp-player">
        <button type="button" class="lp-play" id="lp-play" aria-label="Play" disabled>
          <svg class="i-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5v14l12-7z"></path></svg>
          <svg class="i-replay" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path></svg>
          <svg class="i-pause" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
        </button>
        <span class="lp-time" id="lp-time">0:00</span>
        <div class="lp-track">
          <div class="lp-segments" id="lp-segments" aria-hidden="true"></div>
          <input type="range" id="lp-seek" min="0" step="100" value="0" aria-label="Lesson position" />
        </div>
        <div class="lp-extras">
          <select id="lp-speed" class="lp-chip" aria-label="Speed">
            <option value="0.75">0.75×</option>
            <option value="1" selected>1×</option>
            <option value="1.25">1.25×</option>
            <option value="1.5">1.5×</option>
            <option value="2">2×</option>
          </select>
          <button type="button" id="lp-cc" class="lp-chip" aria-pressed="true">
            <span class="lp-cc-long">Captions</span><span class="lp-cc-short" aria-hidden="true">CC</span>
          </button>
        </div>
      </footer>
    </div>
    <script>
      import { startLesson } from "../../learn/lesson-page.ts";
      startLesson(document.getElementById("lp")!.dataset.slug!);
    </script>
  </body>
</html>
