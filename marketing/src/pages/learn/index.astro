---
// Where students start: the lesson they were last in, then every playlist with how far through
// it they are. Progress lives in the browser, so the page fills it in on load.
import "@fontsource-variable/recursive/full.css";
import "../../learn/learn.css";
import Account from "../../learn/Account.astro";
import { catalogJson, minutes, playlists, playlistUrl, teacher } from "../../learn/catalog";

const play = '<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5v14l12-7z"></path></svg>';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1a1512" />
    <title>Lessons · crow</title>
    <meta name="description" content={`Narrated coding lessons by ${teacher.name}, in playlists.`} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  </head>
  <body class="learn">
    <header class="cp-top">
      <a class="cp-brand" href="/">crow</a>
      <nav class="pl-nav" aria-label="Learn">
        <a class="cp-toplink" href="/learn/progress/">Your progress</a>
        <a class="cp-toplink" href="/web/">Open the scratchpad</a>
      </nav>
    </header>

    <main class="cp">
      <section class="pl-head" aria-labelledby="pl-title">
        <p class="cp-by">Lessons by {teacher.name}</p>
        <h1 id="pl-title">Playlists</h1>
      </section>

      <section class="pl-continue" id="pl-continue" aria-labelledby="pl-continue-h" hidden>
        <p class="pl-continue-label" id="pl-continue-h">Pick up where you left off</p>
        <div class="pl-continue-body">
          <div class="pl-continue-text">
            <a class="pl-continue-title" id="pl-continue-title" href="/learn/"></a>
            <span class="cp-row-meta" id="pl-continue-meta"></span>
            <span class="pl-bar" aria-hidden="true"><span class="pl-fill" id="pl-continue-fill"></span></span>
          </div>
          <a class="cp-cta" id="pl-continue-go" href="/learn/"><Fragment set:html={play} /><span id="pl-continue-go-label">Continue</span></a>
        </div>
      </section>

      <section class="pl-lists" aria-label="Playlists">
        <ul class="pl-cards">
          {playlists.map((p) => (
            <li class="pl-card" data-playlist={p.slug}>
              <div class="pl-card-text">
                <a class="pl-card-title" href={playlistUrl(p)}>{p.title}</a>
                <p class="pl-card-intro">{p.intro}</p>
                <span class="cp-row-meta">{p.lessons.length} {p.lessons.length === 1 ? "lesson" : "lessons"} · {minutes(p.durationMs)}</span>
              </div>
              <div class="pl-card-go">
                <span class="pl-bar" aria-hidden="true"><span class="pl-fill"></span></span>
                <span class="pl-card-count"></span>
                <a class="cp-start pl-card-start" href={`/learn/${p.lessons[0].slug}`}><Fragment set:html={play} /><span class="pl-card-start-label">Start</span></a>
              </div>
            </li>
          ))}
        </ul>
        <Account />
      </section>
    </main>
    <script type="application/json" id="catalog" set:html={catalogJson()} />
    <script>
      import { paintIndex } from "../../learn/overview.ts";
      import { initAccount } from "../../learn/course-page.ts";
      paintIndex();
      initAccount(paintIndex);
    </script>
  </body>
</html>
