---
// In-browser editor — bundled through Astro/Vite (NPM imports for CodeMirror,
// @lezer/highlight, @babel/standalone) so module dedup is guaranteed. The
// editor markup is rendered server-side; the runtime mounts in a `client:load`
// script tag below.
//
// global.css runs Tailwind so the floating ThemeToggle's utility classes
// (fixed/bottom-4/etc) resolve here too — without it the picker renders
// unstyled and ends up invisible in the page corner.
import "../../styles/global.css";
import "../../web/style.css";
import { BUILT_IN_THEMES } from "../../lib/theme-plugins";
import { EXAMPLE_CATEGORIES } from "../../web/examples";
import { readFileSync } from "node:fs";
import course from "../../learn/course.json";
import { formatTime } from "../../web/lesson";

// The course's lessons, in course order; each has its page at /learn/<slug>.
// Relative to the project root (Astro's cwd): import.meta.url points into dist/ once bundled.
const LESSONS = course.lessons.map((slug) => {
  const l = JSON.parse(readFileSync(`public/lessons/${slug}.json`, "utf8"));
  return { slug, title: l.title, kind: l.kind, language: l.language, length: formatTime(l.durationMs) };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>justrunjs — in your browser</title>
    <script is:inline>
      // Lessons moved to their own pages; old /web/?lesson=<name> links still work.
      (function () {
        var lesson = new URLSearchParams(location.search).get("lesson");
        if (lesson) location.replace("/learn/" + encodeURIComponent(lesson));
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <style>
      /* Inline so it always renders, even if style.css 404s. */
      #boot-error {
        position: fixed; inset: 0; padding: 24px 32px;
        background: #1a0f0e; color: #f8b3ad;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 13px; line-height: 1.5; white-space: pre-wrap;
        z-index: 9999; overflow: auto;
      }
      #boot-error h2 { margin: 0 0 8px; font-size: 14px; color: #ffd1cc; }
    </style>
    <script is:inline>
      (function () {
        function show(label, detail) {
          var existing = document.getElementById("boot-error");
          var pre = existing || document.createElement("div");
          pre.id = "boot-error";
          pre.innerHTML =
            '<h2>' + label + '</h2>' +
            (detail || "").toString().replace(/[<>&]/g, function (c) {
              return { "<": "&lt;", ">": "&gt;", "&": "&amp;" }[c];
            });
          if (!existing && document.body) document.body.appendChild(pre);
        }
        window.addEventListener("error", function (e) {
          var d = e.error && e.error.stack ? e.error.stack : (e.message || String(e));
          if (e.filename) d = e.filename + ":" + e.lineno + "\n\n" + d;
          show("Boot error", d);
        });
        window.addEventListener("unhandledrejection", function (e) {
          var r = e.reason;
          show("Unhandled rejection", (r && r.stack) || (r && r.message) || String(r));
        });
      })();
    </script>
  </head>
  <body>
    <aside id="sidebar" aria-label="actions">
      <button class="icon-btn" id="btn-run" aria-label="Run (⌘↵)" data-label="Run (⌘↵)" data-short="Run">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M7 4.5v15l13-7.5z" />
        </svg>
      </button>
      <button class="icon-btn" id="btn-stop" aria-label="Stop" data-label="Stop" data-short="Stop">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <rect x="5" y="5" width="14" height="14" rx="1.5" />
        </svg>
      </button>
      <button class="icon-btn" id="btn-examples" aria-label="Examples & lessons" data-label="Examples & lessons" data-short="Lessons">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 4h9a2 2 0 0 1 2 2v14a1 1 0 0 0-1-1H4z" />
          <path d="M20 4h-3a2 2 0 0 0-2 2v14a1 1 0 0 1 1-1h4z" />
        </svg>
      </button>
      <button class="icon-btn author-only" id="btn-record" aria-label="Record a lesson" data-label="Record a lesson" data-short="Record" aria-pressed="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <circle cx="12" cy="12" r="7" />
        </svg>
      </button>
      <button class="icon-btn" id="btn-share" aria-label="Share (copy link)" data-label="Share (copy link)" data-short="Share">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="18" cy="5" r="3" />
          <circle cx="6" cy="12" r="3" />
          <circle cx="18" cy="19" r="3" />
          <line x1="8.6" y1="10.7" x2="15.4" y2="6.3" />
          <line x1="8.6" y1="13.3" x2="15.4" y2="17.7" />
        </svg>
      </button>
      <div class="sidebar-spacer"></div>
      <div class="sidebar-status" id="sidebar-status" title="ready">
        <span class="status-dot" aria-hidden="true"></span>
      </div>
      <button class="icon-btn" id="btn-account" aria-label="Sign in to save your work" data-label="Sign in to save your work" data-short="Account">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="8" r="4" />
          <path d="M4 21a8 8 0 0 1 16 0" />
        </svg>
      </button>
      <button class="icon-btn" id="btn-settings" aria-label="Settings" data-label="Settings" data-short="Settings">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3" />
          <path d="M19.14 12.94a7.957 7.957 0 0 0 0-1.88l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.61-.22l-2.39.96a8.07 8.07 0 0 0-1.62-.94l-.36-2.54A.5.5 0 0 0 13.91 2h-3.82a.5.5 0 0 0-.5.42l-.36 2.54c-.59.24-1.13.55-1.62.94l-2.39-.96a.5.5 0 0 0-.61.22L2.7 8.48a.5.5 0 0 0 .12.64l2.03 1.58a7.957 7.957 0 0 0 0 1.88L2.82 14.16a.5.5 0 0 0-.12.64l1.92 3.32a.5.5 0 0 0 .61.22l2.39-.96c.49.39 1.03.7 1.62.94l.36 2.54a.5.5 0 0 0 .5.42h3.82a.5.5 0 0 0 .5-.42l.36-2.54c.59-.24 1.13-.55 1.62-.94l2.39.96a.5.5 0 0 0 .61-.22l1.92-3.32a.5.5 0 0 0-.12-.64l-2.03-1.58z" />
        </svg>
      </button>
      <a class="icon-btn" id="btn-home" href="/" aria-label="Back to overview" data-label="Back to overview" data-short="Home">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12l9-9 9 9" />
          <path d="M5 10v10h14V10" />
        </svg>
      </a>
    </aside>
    <main>
      <div id="editor">
        <div class="tab-bar">
          <div id="tabs" role="tablist" aria-label="Open tabs"></div>
          <span id="save-status" class="save-status" role="status" aria-live="polite"></span>
          <button id="btn-new-tab" class="tab-new" title="New tab" aria-label="New tab">+</button>
        </div>
        <div id="panel-tabs" class="panel-tabs hidden" role="tablist"></div>
        <div id="editor-host"></div>
        <div id="lesson-bar" class="lesson-bar hidden" role="toolbar" aria-label="Lesson recording"></div>
      </div>
      <div id="splitter" aria-hidden="true"></div>
      <div id="results">
        <button id="btn-expand" class="hidden" title="Toggle full screen" aria-label="Toggle full screen">
          <svg class="icon-expand" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 3 21 3 21 9" />
            <polyline points="9 21 3 21 3 15" />
            <line x1="21" y1="3" x2="14" y2="10" />
            <line x1="3" y1="21" x2="10" y2="14" />
          </svg>
          <svg class="icon-collapse" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="4 14 10 14 10 20" />
            <polyline points="20 10 14 10 14 4" />
            <line x1="14" y1="10" x2="21" y2="3" />
            <line x1="3" y1="21" x2="10" y2="14" />
          </svg>
        </button>
        <div id="preview-pane" class="preview-pane hidden">
          <iframe
            id="preview"
            class="preview"
            title="Live preview"
            sandbox="allow-scripts allow-modals allow-popups allow-forms"
          ></iframe>
          <div id="console-drawer" class="console-drawer">
            <div id="console-head" class="console-head">
              <button id="console-toggle" class="console-toggle" title="Collapse / expand console">
                <span class="console-title">Console</span>
                <span id="console-count" class="console-count"></span>
              </button>
              <button id="console-clear" class="console-clear" title="Clear console">Clear</button>
            </div>
            <div id="console-log" class="console-log"></div>
          </div>
        </div>
      </div>
    </main>

    <div id="examples-popover" class="examples-popover hidden" role="dialog" aria-label="Examples and lessons">
      <div class="examples-header">
        <span class="examples-heading">Examples &amp; lessons</span>
        <span class="examples-sub">Lessons open in the classroom; examples open in a new tab</span>
      </div>
      <div class="examples-scroll">
        {LESSONS.length > 0 && (
          <div class="examples-group">
            <div class="examples-group-title">Lessons</div>
            {LESSONS.map((l) => (
              <a class="example-item" href={`/learn/${l.slug}`}>
                <span class="example-item-top">
                  <span class="example-title">{l.title}</span>
                  <span class:list={["example-lang", l.kind === "playground" ? "lang-play" : l.language === "typescript" ? "lang-ts" : "lang-js"]}>
                    {l.kind === "playground" ? "</>" : l.language === "typescript" ? "TS" : "JS"}
                  </span>
                </span>
                <span class="example-blurb">Narrated lesson · {l.length}</span>
              </a>
            ))}
          </div>
        )}
        {
          EXAMPLE_CATEGORIES.map((cat) => (
            <div class="examples-group">
              <div class="examples-group-title">{cat.name}</div>
              {cat.examples.map((ex) => (
                <button
                  type="button"
                  class="example-item"
                  data-example-id={ex.id}
                  data-example-name={ex.title}
                >
                  <span class="example-item-top">
                    <span class="example-title">{ex.title}</span>
                    <span
                      class:list={[
                        "example-lang",
                        ex.kind === "playground"
                          ? "lang-play"
                          : ex.language === "typescript"
                            ? "lang-ts"
                            : "lang-js",
                      ]}
                    >
                      {ex.kind === "playground"
                        ? "</>"
                        : ex.language === "typescript"
                          ? "TS"
                          : "JS"}
                    </span>
                  </span>
                  <span class="example-blurb">{ex.blurb}</span>
                </button>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <div id="toast" class="toast hidden" role="status" aria-live="polite"></div>
    <div id="new-tab-menu" class="settings-popover new-tab-menu hidden" role="dialog" aria-label="New tab">
      <div class="settings-section">
        <button type="button" class="new-tab-option" data-new="typescript"><span class="example-lang lang-ts">TS</span>TypeScript scratchpad</button>
        <button type="button" class="new-tab-option" data-new="javascript"><span class="example-lang lang-js">JS</span>JavaScript scratchpad</button>
        <button type="button" class="new-tab-option" data-new="npm"><span class="example-lang lang-ts">TS</span>Scratchpad with an npm import</button>
        <button type="button" class="new-tab-option" data-new="playground"><span class="example-lang lang-play">&lt;/&gt;</span>HTML/CSS/JS playground</button>
      </div>
    </div>
    <div id="account-popover" class="settings-popover account-popover hidden" role="dialog" aria-label="Account"></div>

    <div id="settings-popover" class="settings-popover hidden" role="dialog" aria-label="Settings">
      <div class="settings-section">
        <div class="settings-title">Appearance</div>

        <button id="settings-mode-toggle" type="button" class="settings-mode-btn">
          <span data-mode-label="light">Switch to dark</span>
          <span data-mode-label="dark" class="hidden">Switch to light</span>
        </button>

        <div class="settings-themes">
          {
            BUILT_IN_THEMES.map((t) => (
              <button
                type="button"
                class="theme-option"
                data-theme-option={t.id}
                title={t.label}
              >
                <span class="theme-swatch" aria-hidden="true">
                  <span style={`background-color: ${t.swatch.dark}; flex: 1;`} />
                  <span style={`background-color: ${t.swatch.light}; flex: 1;`} />
                </span>
                <span class="theme-name">{t.label}</span>
                <span class="theme-check" aria-label="Active">✓</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="settings-section">
        <div class="settings-title">Editor</div>

        <div class="settings-row settings-row-inline">
          <span>Font size</span>
          <input type="number" id="opt-font-size" min="10" max="24" step="1" />
        </div>

        <div class="settings-row settings-row-inline">
          <span>Indent size</span>
          <div class="settings-segmented">
            <label><input type="radio" name="opt-tab-size" value="2" /><span>2</span></label>
            <label><input type="radio" name="opt-tab-size" value="4" /><span>4</span></label>
          </div>
        </div>

        <label class="settings-row">
          <span>Show line numbers</span>
          <input type="checkbox" id="opt-line-numbers" />
        </label>

        <label class="settings-row">
          <span>Word wrap</span>
          <input type="checkbox" id="opt-word-wrap" />
        </label>

        <label class="settings-row">
          <span>Run code as you type</span>
          <input type="checkbox" id="opt-auto-eval" />
        </label>

        <label class="settings-row">
          <span>Show values in playground code</span>
          <input type="checkbox" id="opt-playground-inline" />
        </label>
        <label class="settings-row">
          <span>Lesson recording (for authors)</span>
          <input type="checkbox" id="opt-author" />
        </label>
      </div>
      <div class="settings-section">
        <div class="settings-title">Keyboard</div>
        <dl class="shortcut-list">
          <dt><kbd>⌘</kbd><kbd>↵</kbd></dt><dd>Run the code (Ctrl+Enter on Windows)</dd>
          <dt><kbd>Esc</kbd></dt><dd>Close a panel</dd>
          <dt><kbd>⌘</kbd><kbd>Delete</kbd></dt><dd>Close the focused tab</dd>
        </dl>
      </div>
    </div>

    <script>
      // Theme tokens applied to <html> before stylesheets resolve. Imported
      // here so Astro/Vite bundles it; runs on the main thread synchronously
      // when the module loads.
      import "../../web/theme-boot.ts";
      // Editor runtime. CodeMirror + worker bridge.
      import "../../web/main.ts";
    </script>
  </body>
</html>
