---
// The landing page: crow is a place to learn to code first (the lessons), and a scratchpad to
// keep practising in second. A real lesson playing is the proof. Every picture of crow here is crow itself: the hero is the lesson page
// in its demo mode, and the screenshots are captured from the running app.
import Layout from '../layouts/Layout.astro';
import '../styles/landing.css';
import course from '../learn/course.json';

const repoUrl = 'https://github.com/codellyson/justrunjs';
const firstLesson = course.lessons[0];
const demoLesson = 'array-basics';
const lessonCount = course.lessons.length;

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'crow',
  description:
    'Learn to code in a live editor: narrated lessons where the code types itself in, each value shows up beside its line, and you can take over the code at any moment. Plus a TypeScript and JavaScript scratchpad to keep practising.',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: Astro.site?.toString(),
};
---

<Layout jsonLd={softwareJsonLd}>
  <div class="ld">
    <header class="ld-top">
      <a class="ld-brand" href="/"><img src="/crow-small.svg" alt="" width="46" height="30" />crow</a>
      <nav class="ld-nav" aria-label="Main">
        <a href="/learn/">Lessons</a>
        <a href="/web/">Scratchpad</a>
        <a href={repoUrl}>GitHub</a>
      </nav>
    </header>

    <main>
      <section class="ld-hero" aria-labelledby="ld-hero-h">
        <div class="ld-hero-text">
          <img class="ld-bird" src="/crow.svg" alt="" width="320" height="209" />
          <h1 id="ld-hero-h">Learn to code in a live editor.</h1>
          <p class="ld-lede">Each lesson is me typing and talking you through the code. Every value shows up beside its line, and you can take over the code at any moment.</p>
          <div class="ld-actions">
            <a class="ld-btn" href="/learn/">Start the course</a>
            <a class="ld-learn" href="/web/">
              Or just try some code in the scratchpad
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
            </a>
          </div>
          <p class="ld-note">Free, and no account needed. {lessonCount} {lessonCount === 1 ? 'lesson' : 'lessons'} so far.</p>
        </div>
        <figure class="ld-demo">
          <iframe
            src={`/learn/${demoLesson}?demo`}
            title="A crow lesson playing with the sound off: code types in and each value appears beside its line. Click to open the lesson."
            tabindex="-1"
          ></iframe>
          <figcaption>A real lesson, playing with the sound off. Click it to watch with sound.</figcaption>
        </figure>
      </section>


      <section class="ld-lessons" aria-labelledby="ld-lessons-h">
        <div class="ld-lessons-in">
          <div class="ld-lessons-text">
            <p class="ld-by">Lessons by {course.teacher.name}</p>
            <h2 id="ld-lessons-h">Take over the code at any moment.</h2>
            <p class="ld-sub">A lesson isn't a video of an editor. It is the editor: pause anywhere, change my code, run it, and pick the lesson back up where I paused.</p>
            <ul class="ld-steps">
              <li><strong class="ld-watch">Watch.</strong> I talk you through the code as I write it.</li>
              <li><strong class="ld-try">Try it.</strong> Click the code to get your own copy to change and run.</li>
              <li><strong>Come back.</strong> Pick the lesson up where I paused. Your copy stays saved.</li>
            </ul>
            <div class="ld-actions">
              <a class="ld-btn ld-btn-student" href={`/learn/${firstLesson}`}>Start lesson 1</a>
              <a class="ld-quiet" href="/learn/">See every lesson</a>
            </div>
          </div>
          <div class="ld-shot-wrap">
            <img
              class="ld-shot ld-turn"
              src="/landing/your-turn.webp"
              width="2208"
              height="928"
              loading="lazy"
              alt="A student's own copy of a lesson in crow: their new line is underlined in teal with its value, beside Continue the lesson and Reset to my code"
            />
          </div>
        </div>
      </section>

      <section class="ld-pad" aria-labelledby="ld-pad-h">
        <h2 id="ld-pad-h">Keep practising in the scratchpad.</h2>
        <p class="ld-sub">Between lessons, or whenever you want to try an idea: TypeScript or JavaScript, nothing to install, and each line's value shows up right beside it.</p>
        <div class="ld-shot-wrap">
          <img
            class="ld-shot"
            src="/landing/scratchpad.webp"
            width="2104"
            height="940"
            loading="lazy"
            alt="The crow scratchpad running TypeScript, an npm package and an array map, each value beside its line, and an unclosed bracket explained on its own line"
          />
        </div>
        <div class="ld-points">
          <p><strong>TypeScript with no setup.</strong> No project, no tsconfig. Switch any tab between TS and JS.</p>
          <p><strong>Any npm package.</strong> Add <code>npm:</code> to an import and it loads in the browser.</p>
          <p><strong>Errors in plain words.</strong> On the line that caused them, and the lines above keep their values.</p>
        </div>
        <a class="ld-quiet ld-pad-go" href="/web/">Open the scratchpad</a>
      </section>
    </main>

    <footer class="ld-foot">
      <span><strong>crow</strong> · open source, runs in your browser</span>
      <nav aria-label="Footer">
        <a href="/learn/">Lessons</a>
        <a href="/web/">Scratchpad</a>
        <a href={repoUrl}>GitHub</a>
      </nav>
    </footer>
  </div>
</Layout>
